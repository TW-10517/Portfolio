# Copy to .env and fill in for production. Safe defaults are used in local dev if unset.

# Local dev: leave unset to use server/data.sqlite (auto-created).
# Currently this is only a filesystem path for better-sqlite3 — it does NOT accept a Postgres
# connection string. Swapping to a hosted Postgres (e.g. Supabase) requires changing server/db.js
# to use a Postgres driver; see README "Moving to a hosted database" for what that involves.
DATABASE_URL=

# Secret used to sign login sessions (JWTs). MUST be changed to a long random string in production —
# the code falls back to a well-known insecure default if unset, which is fine for local dev only.
JWT_SECRET=

# Port the API server listens on.
PORT=4000

# Frontend: base URL the browser should call for the API. Only needed if the API isn't on localhost:4000.
VITE_API_URL=
