# Copy to .env and fill in for production. Safe defaults are used in local dev if unset.

# Local dev: leave unset to use server/data.sqlite (auto-created).
# Currently this is only a filesystem path for better-sqlite3 — it does NOT accept a Postgres
# connection string. Swapping to a hosted Postgres (e.g. Supabase) requires changing server/db.js
# to use a Postgres driver; see README "Moving to a hosted database" for what that involves.
DATABASE_URL=

# Secret used to sign login sessions (JWTs). MUST be changed to a long random string in production —
# the code falls back to a well-known insecure default if unset, which is fine for local dev only.
JWT_SECRET=

# Port the API server listens on.
PORT=4000

# Frontend: base URL the browser should call for the API. Only needed if the API isn't on localhost:4000.
VITE_API_URL=

# Comma-separated list of origins allowed to call the API (CORS). Defaults to
# http://localhost:5173 (the Vite dev server) if unset. Set this to your real
# frontend origin(s) before deploying — the API rejects cross-origin requests
# from anything not in this list.
CORS_ORIGIN=

# Base URL used to build the links sent to users (password reset, email
# verification). Defaults to http://localhost:5173. No email provider is
# wired up — by design, so the app never requires connecting a third-party
# mail service — so these links are currently logged to the API server's
# console instead of emailed. Wire a real provider into
# server/routes/auth.js's deliverLink() before relying on this in production.
FRONTEND_URL=
