# Copy to .env and fill in for production. Safe defaults are used in local dev if unset.

# Which database to use. Leave unset for SQLite at server/data.sqlite (auto-created) — the
# right answer for a single host with a real disk, and no setup at all.
#
#   (unset) or a path      SQLite, e.g. ./server/data.sqlite or :memory:
#   postgres://user:pw@host/db   PostgreSQL — use this on any host with an ephemeral
#                                filesystem, where a SQLite file vanishes on redeploy.
#                                The free tier of Supabase/Neon/Render is enough.
#   pglite                 PostgreSQL compiled to WASM, in-process, no server. This is what
#                                `npm run test:pg` uses; not intended for production.
#
# For a hosted Postgres, append ?sslmode=verify-full — spelled out rather than the more common
# `require`, because pg 8 treats `require` as verify-full and pg 9 will not, so relying on it
# means a dependency bump quietly stops checking who you're connected to. For a server on your
# own network with a self-signed certificate, use ?sslmode=no-verify and know what you're
# trading away.
#
# The schema is created automatically on first boot either way.
DATABASE_URL=

# Secret used to sign login sessions (JWTs). MUST be changed to a long random string in production —
# the code falls back to a well-known insecure default if unset, which is fine for local dev only.
JWT_SECRET=

# Port the API server listens on.
PORT=4000

# How many reverse proxies sit in front of this app. Set this whenever you deploy behind one —
# which is every managed host. Without it, req.ip is the proxy's address for everybody, so all
# visitors share a single rate-limit bucket and one person mistyping a password locks out the
# whole site. Leaving it unset is still the right answer when the app is exposed directly:
# believing X-Forwarded-For from anyone lets a client claim any address and skip the limits.
#   1  the usual platform setup (Render, Fly, Railway, Heroku)
#   2  a CDN in front of the platform (Cloudflare -> host)
TRUST_PROXY=

# Frontend: base URL the browser should call for the API. Only needed if the API isn't on localhost:4000.
# This is also the value `vite preview` substitutes into the Content-Security-Policy it reads
# from public/_headers, so a local preview behaves like the deployed site. The deployed policy
# comes from that file, not from here: replace YOUR-API-HOST in it before building.
VITE_API_URL=

# Comma-separated list of origins allowed to call the API (CORS). Defaults to
# http://localhost:5173 (the Vite dev server) if unset. Set this to your real
# frontend origin(s) before deploying — the API rejects cross-origin requests
# from anything not in this list.
CORS_ORIGIN=

# Base URL used to build the links sent to users (password reset, email
# verification). Defaults to http://localhost:5173.
FRONTEND_URL=

# How those links reach people.
#   console  (default) print them to the API server's log. Nothing to set up,
#            and genuinely enough for a self-hosted instance you run yourself.
#   smtp     send them, using the settings below. Any provider's free tier
#            works, or your own mail server — SMTP is just SMTP.
MAIL_TRANSPORT=

# Only needed when MAIL_TRANSPORT=smtp. Port 465 is implicit TLS; 587 and 25
# start plain and upgrade with STARTTLS, which SMTP_SECURE follows by default.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
MAIL_FROM="Portfolio Builder <no-reply@yourdomain.com>"

# Maximum pooled Postgres connections (ignored on SQLite). Free tiers cap
# these low; the default of 10 is fine for a single process on most of them.
DATABASE_POOL_MAX=

# Logging. LOG_LEVEL is debug|info|warn|error (default info). LOG_FORMAT is json|pretty —
# pretty is the default on a terminal, json everywhere else so a log aggregator can parse it.
LOG_LEVEL=
LOG_FORMAT=

# Optional. Errors are POSTed here as JSON as well as being logged — a Sentry endpoint, a Slack
# webhook, or your own. Off unless set: entries are redacted, but sending anything off your own
# servers should be a decision you make rather than a default you inherit.
ERROR_WEBHOOK_URL=
