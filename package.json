    "express-rate-limit": "^8.6.2",
    "framer-motion": "^11.2.10",
    "jsonwebtoken": "^9.0.3",
    "lz-string": "^1.5.0",
    "pdfjs-dist": "^4.7.76",
    "pg": "^8.23.0",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "zustand": "^4.5.2"
  },
